    box-shadow: 0 12px 40px rgb(0 0 0 / 0.18);
  }
  .thumbs {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
    max-width: 76%;
  }
  .thumb {
    aspect-ratio: 16 / 10;
    border-radius: 0.75rem;
    box-shadow: 0 0 0 1px var(--line);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .thumb-phone img {
    object-position: top center;
  }
  .did {
    font-weight: 500;
  }
  .tech summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    list-style: none;
