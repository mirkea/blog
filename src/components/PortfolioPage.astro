  .browser-bar i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--line);
  }
  .browser-url {
    margin-inline: auto;
    padding-right: 2.25rem;
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .phone {
    position: absolute;
    right: -0.5rem;
