</style>

<script>
  const viewer = document.getElementById("shot-viewer") as HTMLDialogElement | null;
  const full = viewer?.querySelector("img");
  document.querySelectorAll<HTMLButtonElement>(".portfolio .shot").forEach((b) => {
    b.addEventListener("click", () => {
      if (!viewer || !full) return;
      full.src = b.dataset.full || "";
      full.alt = b.querySelector("img")?.alt || "";
      viewer.showModal();
    });
  });
  // Click outside the image closes it
  viewer?.addEventListener("click", (e) => {
    if (e.target === viewer) viewer.close();
  });
</script>
