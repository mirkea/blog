  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    padding-inline: 0.875rem;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .section-surface .browser-bar {
    background: var(--canvas);
