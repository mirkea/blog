const byStart = [...list].sort((a, b) => startOrder.indexOf(a.slug) - startOrder.indexOf(b.slug));
const img = (slug: string, shot: string) => `${base}portfolio/${slug}-${shot}.webp`;
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");
---

<Layout title={ui.title} description={ui.description} lang={lang} wide noindex>
  <div class="portfolio">
    <section class="section section-surface !pt-10 sm:!pt-14">
      <div class="wrap">
        <div class="flex items-center gap-4">
          <span class="pill pill-float">{ui.eyebrow}</span>
          <a href={ui.switchHref} hreflang={lang === "ro" ? "en" : "ro"} class="link-underline ml-auto text-sm">{ui.switchLabel}</a>
        </div>
        <div class="rise mt-10 sm:mt-14">
          <h1 class="title max-w-5xl">
            <span class="block">{ui.h1}</span>
            <span class="tone-2 block">{ui.h1b}</span>
          </h1>
          <p class="lead mt-6 max-w-3xl">{ui.lead}</p>
          <p class="body mt-4 max-w-3xl text-ink">{ui.ctaFit}</p>
          <a href={`${base}fondatori`} class="link-underline mt-3 inline-flex items-center gap-1.5 text-sm font-medium">{ui.founders}<Icon name="arrow-right" class="size-4" /></a>
        </div>
        <div class="rise mt-10 flex max-w-3xl items-start gap-5">
          <img src={`${base}profile.webp`} alt="Mircea Braescu" width="80" height="80" class="size-16 shrink-0 rounded-full object-cover sm:size-20" />
          <div>
            <p class="body">{ui.about}</p>
            <p class="body mt-2">{ui.ai}</p>
            <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
              <a href={`tel:${phone.href}`} data-umami-event="portfolio-call-top" class="btn btn-primary"><Icon name="phone" />{ui.call}: {ui.ctaPhone}</a>
              <a href={`https://wa.me/${phone.href.slice(1)}`} target="_blank" rel="noopener" data-umami-event="portfolio-whatsapp-top" class="btn btn-secondary"><Icon name="message" />{ui.ctaWa}</a>
              <a href="https://www.linkedin.com/in/mircea-braescu/" target="_blank" rel="noopener" class="link-underline inline-flex items-center gap-1.5 text-sm font-medium">{ui.linkedin}<Icon name="arrow-up-right" class="size-4" /></a>
            </div>
          </div>
        </div>
        <nav class="rise mt-10 flex flex-wrap gap-2" aria-label={ui.eyebrow}>
          <span class="caption self-center mr-1">{ui.since}</span>
          {byStart.map((p) => <a href={`#${p.slug}`} class="pill pill-quiet hover:text-ink">{p.name}<span class="tone-2 ml-1.5 font-normal">{month(p.period)}</span></a>)}
        </nav>
      </div>
    </section>

    {
      list.map((p, i) => (
        <section id={p.slug} class:list={["section project", i % 2 === 1 && "section-surface"]}>
          <div class="wrap project-grid">
            <div class="rise p-head min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="pill pill-ink">{p.status}</span>
                <span class="caption">{p.period}</span>
              </div>
              <h2 class="title-sm mt-5">{p.name}</h2>
              <p class="lead mt-3">{p.what}</p>
              <div class="mt-5">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener" class="link-underline inline-flex items-center gap-1.5 font-medium">
                    {host(p.url)}
                    <Icon name="arrow-up-right" class="size-4" />
                  </a>
                ) : (
                  <span class="caption">{p.privateNote}</span>
                )}
              </div>
              <div class="mt-6">
                <p class="label">{ui.role}</p>
                <p class="mt-1.5 text-[1.0625rem] font-medium leading-relaxed text-ink">{p.role}</p>
              </div>
              {p.client && (
                <div class="mt-5">
                  <p class="label">{ui.client}</p>
                  <p class="body mt-1.5">{p.client}</p>
                  {p.people && (
                    <div class="mt-3 flex flex-wrap gap-x-5 gap-y-3">
                      {p.people.map((m) => {
                        const face = m.photo ? (
                          <img src={`${base}portfolio/people/${m.photo}.webp`} alt={m.name} width="40" height="40" loading="lazy" class="size-10 rounded-full object-cover" />
                        ) : (
                          <span class="avatar-empty" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><circle cx="12" cy="8.5" r="4" /><path d="M4 20.5c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5z" /></svg></span>
                        );
                        return m.linkedin ? (
                          <a href={m.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 text-sm font-medium">
                            {face}
                            <span class="link-underline">{m.name}</span>
                            <Icon name="arrow-up-right" class="size-4" />
                          </a>
                        ) : (
                          <span class="inline-flex items-center gap-2.5 text-sm font-medium text-ink">{face}{m.name}</span>
                        );
                      })}
                    </div>
                  )}
                </div>
              )}
            </div>

            <div class="rise p-body min-w-0">
              <dl class="space-y-6">
                <div>
                  <dt class="label">{ui.forWho}</dt>
                  <dd class="body mt-1.5">{p.forWho}</dd>
                </div>
                <div>
                  <dt class="label">{ui.does}</dt>
                  <dd class="body mt-1.5">{p.does}</dd>
                </div>
                <div>
                  <dt class="label">{ui.did}</dt>
                  <dd class="mt-3 flex flex-wrap gap-2">
                    {p.did.map((d) => <span class="pill did">{d}</span>)}
                  </dd>
                </div>
                <div>
                  <details class="tech">
                    <summary class="label">{ui.tech}<Icon name="chevron-down" class="size-4" /></summary>
                    <p class="caption mt-1.5">{p.tech}</p>
                  </details>
                </div>
              </dl>
            </div>

            <div class="rise p-media min-w-0">
              <div class="stage">
                <button type="button" class="shot browser" data-full={img(p.slug, "desktop-1")} aria-label={`${ui.zoom}: ${p.name}`}>
                  <span class="browser-bar" aria-hidden="true">
                    <i /><i /><i />
                    <span class="browser-url">{p.url ? host(p.url) : p.name}</span>
                  </span>
                  <img src={img(p.slug, "desktop-1")} alt={`${p.name}, desktop`} width="1920" height="1200" loading={i === 0 ? "eager" : "lazy"} />
                </button>
                {p.phone !== false && <button type="button" class="shot phone" data-full={img(p.slug, "mobile-1")} aria-label={`${ui.zoom}: ${p.name}, mobile`}>
                  <img src={img(p.slug, "mobile-1")} alt={`${p.name}, mobile`} width="600" height="1298" loading="lazy" />
                </button>}
              </div>
              <div class="thumbs" style={`--n:${Math.max(p.shots.length, 3)}`}>
                {p.shots.map((s) => (
                  <button type="button" class:list={["shot thumb", s.startsWith("mobile") && "thumb-phone"]} data-full={img(p.slug, s)} aria-label={`${ui.zoom}: ${p.name}`}>
                    <img src={img(p.slug, s)} alt={`${p.name}, ${s.startsWith("mobile") ? "mobile" : "desktop"}`} loading="lazy" />
                  </button>
                ))}
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <section class:list={["section", list.length % 2 === 1 && "section-surface"]}>
      <div class="wrap">
        <div class="rise max-w-3xl">
          <h2 class="title-sm">{ui.beforeTitle}</h2>
          <p class="body mt-3">{ui.beforeLead}</p>
        </div>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {ui.before.map((b) => (
            <div class="rise card">
              <h3 class="text-lg font-semibold text-ink">{b.name}</h3>
              <p class="body mt-2">{b.what}</p>
              <p class="label mt-5">{ui.role}</p>
              <p class="body mt-1.5 text-ink">{b.role}</p>
              {b.url && (
                <a href={b.url} target="_blank" rel="noopener" class="link-underline mt-4 inline-flex items-center gap-1.5 text-sm font-medium">
                  {host(b.url)}
                  <Icon name="arrow-up-right" class="size-4" />
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class:list={["section", list.length % 2 === 0 && "section-surface"]}>
      <div class="wrap">
        <div class="rise card card-ink flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-2xl">
            <h2 class="title-sm">{ui.ctaTitle}</h2>
            <p class="lead mt-4">{ui.ctaText}</p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={`https://cal.com/${calLink}`} target="_blank" rel="noopener" data-umami-event="portfolio-cal" class="btn btn-invert btn-lg"><Icon name="calendar" />{ui.ctaCal}</a>
            <a href={`tel:${phone.href}`} data-umami-event="portfolio-call" class="btn btn-secondary btn-lg"><Icon name="phone" />{ui.ctaPhone}</a>
            <a href={`https://wa.me/${phone.href.slice(1)}`} target="_blank" rel="noopener" data-umami-event="portfolio-whatsapp" class="btn btn-secondary btn-lg"><Icon name="message" />{ui.ctaWa}</a>
          </div>
        </div>
      </div>
    </section>

    <PortfolioLightbox client:idle />
  </div>
</Layout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "head" "media" "body";
    gap: 2.5rem;
  }
  .p-head { grid-area: head; }
  .p-media { grid-area: media; }
  .p-body { grid-area: body; }
  @media (min-width: 1024px) {
    .project-grid {
      grid-template-columns: 5fr 7fr;
      grid-template-areas: "head media" "body media";
      grid-template-rows: auto 1fr;
      column-gap: 3.5rem;
      row-gap: 2rem;
    }
    .p-media > * {
      position: relative;
    }
    .p-media {
      align-self: start;
      position: sticky;
      top: 6rem;
    }
  }
  .stage {
    position: relative;
    padding: 0 0 2.5rem 0;
  }
  .shot {
    display: block;
    cursor: zoom-in;
    border-radius: 1rem;
    overflow: hidden;
    background: var(--canvas);
    box-shadow: var(--shadow-float);
    transition: transform 0.3s var(--ease);
  }
  .shot:hover {
    transform: translateY(-3px);
  }
  .shot:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .browser {
    width: 100%;
    box-shadow:
      0 0 0 1px var(--line),
      var(--shadow-float);
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    padding-inline: 0.875rem;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .section-surface .browser-bar {
    background: var(--canvas);
  }
  .browser-bar i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--line);
  }
  .browser-url {
    margin-inline: auto;
    padding-right: 2.25rem;
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .phone {
    position: absolute;
    right: -0.5rem;
    bottom: 0;
    width: 24%;
    min-width: 7rem;
    border-radius: 1.5rem;
    border: 5px solid var(--ink);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.18);
  }
  .thumbs {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
    max-width: 76%;
  }
  .thumb {
    aspect-ratio: 16 / 10;
    border-radius: 0.75rem;
    box-shadow: 0 0 0 1px var(--line);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .thumb-phone img {
    object-position: top center;
  }
  .did {
    font-weight: 500;
  }
  .label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .tech summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    list-style: none;
  }
  .tech summary::-webkit-details-marker {
    display: none;
  }
  .tech[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .section-surface .did {
    background: var(--canvas);
  }
  @media (max-width: 639px) {
    .thumbs {
      max-width: 70%;
    }
    .phone {
      right: 0;
      min-width: 6rem;
      border-width: 4px;
      border-radius: 1.1rem;
    }
  }
  .avatar-empty {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: var(--color-line, rgba(127, 127, 127, 0.18));
    color: var(--color-ink-3, rgba(127, 127, 127, 0.75));
    overflow: hidden;
  }
  .avatar-empty svg { margin-top: 0.4rem; }
</style>

