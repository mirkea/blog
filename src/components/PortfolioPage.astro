const list = projects[lang];
const img = (slug: string, shot: string) => `${base}portfolio/${slug}-${shot}.webp`;
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");
---

<Layout title={ui.title} description={ui.description} lang={lang} wide noindex>
  <div class="portfolio">
    <section class="section section-surface !pt-10 sm:!pt-14">
      <div class="wrap">
        <div class="flex items-center gap-4">
          <span class="pill pill-float">{ui.eyebrow}</span>
          <a href={ui.switchHref} hreflang={lang === "ro" ? "en" : "ro"} class="link-underline ml-auto text-sm">{ui.switchLabel}</a>
        </div>
        <div class="rise mt-10 sm:mt-14">
          <h1 class="title max-w-5xl">
            <span class="block">{ui.h1}</span>
            <span class="tone-2 block">{ui.h1b}</span>
          </h1>
          <p class="lead mt-6 max-w-3xl">{ui.lead}</p>
        </div>
        <div class="rise mt-10 flex max-w-3xl items-start gap-5">
          <img src={`${base}profile.webp`} alt="Mircea Braescu" width="80" height="80" class="size-16 shrink-0 rounded-full object-cover sm:size-20" />
          <div>
            <p class="body">{ui.about}</p>
            <p class="body mt-2">{ui.ai}</p>
            <a href="https://www.linkedin.com/in/mircea-braescu/" target="_blank" rel="noopener" class="link-underline mt-3 inline-flex items-center gap-1.5 text-sm font-medium">{ui.linkedin}<Icon name="arrow-up-right" class="size-4" /></a>
          </div>
        </div>
        <nav class="rise mt-10 flex flex-wrap gap-2" aria-label={ui.eyebrow}>
          {list.map((p) => <a href={`#${p.slug}`} class="pill pill-quiet hover:text-ink">{p.name}</a>)}
        </nav>
      </div>
    </section>

    {
      list.map((p, i) => (
        <section id={p.slug} class:list={["section project", i % 2 === 1 && "section-surface"]}>
          <div class="wrap project-grid">
            <div class="rise p-head min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="pill pill-ink">{p.status}</span>
                <span class="caption">{p.period}</span>
              </div>
              <h2 class="title-sm mt-5">{p.name}</h2>
              <p class="lead mt-3">{p.what}</p>
              <div class="mt-5">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener" class="link-underline inline-flex items-center gap-1.5 font-medium">
                    {host(p.url)}
                    <Icon name="arrow-up-right" class="size-4" />
                  </a>
                ) : (
                  <span class="caption">{p.privateNote}</span>
                )}
              </div>
              <div class="mt-6">
                <p class="eyebrow">{ui.role}</p>
                <p class="mt-1.5 text-[1.0625rem] font-medium leading-relaxed text-ink">{p.role}</p>
              </div>
              {p.client && (
                <div class="mt-5">
                  <p class="eyebrow">{ui.client}</p>
                  <p class="body mt-1.5">{p.client}</p>
                </div>
              )}
            </div>

            <div class="rise p-body min-w-0">
              <dl class="space-y-6">
                <div>
                  <dt class="eyebrow">{ui.forWho}</dt>
                  <dd class="body mt-1.5">{p.forWho}</dd>
                </div>
                <div>
                  <dt class="eyebrow">{ui.does}</dt>
                  <dd class="body mt-1.5">{p.does}</dd>
                </div>
                <div>
                  <dt class="eyebrow">{ui.did}</dt>
                  <dd class="mt-3 flex flex-wrap gap-2">
                    {p.did.map((d) => <span class="pill did">{d}</span>)}
                  </dd>
                </div>
                <div>
                  <details class="tech">
                    <summary class="eyebrow">{ui.tech}<Icon name="chevron-down" class="size-4" /></summary>
                    <p class="caption mt-1.5">{p.tech}</p>
                  </details>
                </div>
              </dl>
            </div>

            <div class="rise p-media min-w-0">
              <div class="stage">
                <button type="button" class="shot browser" data-full={img(p.slug, "desktop-1")} aria-label={`${ui.zoom}: ${p.name}`}>
                  <span class="browser-bar" aria-hidden="true">
                    <i /><i /><i />
                    <span class="browser-url">{p.url ? host(p.url) : p.name}</span>
                  </span>
                  <img src={img(p.slug, "desktop-1")} alt={`${p.name}, desktop`} width="1920" height="1200" loading={i === 0 ? "eager" : "lazy"} />
                </button>
                <button type="button" class="shot phone" data-full={img(p.slug, "mobile-1")} aria-label={`${ui.zoom}: ${p.name}, mobile`}>
                  <img src={img(p.slug, "mobile-1")} alt={`${p.name}, mobile`} width="600" height="1298" loading="lazy" />
                </button>
              </div>
              <div class="thumbs" style={`--n:${p.shots.length}`}>
                {p.shots.map((s) => (
                  <button type="button" class:list={["shot thumb", s.startsWith("mobile") && "thumb-phone"]} data-full={img(p.slug, s)} aria-label={`${ui.zoom}: ${p.name}`}>
                    <img src={img(p.slug, s)} alt={`${p.name}, ${s.startsWith("mobile") ? "mobile" : "desktop"}`} loading="lazy" />
                  </button>
                ))}
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <section class:list={["section", list.length % 2 === 1 && "section-surface"]}>
      <div class="wrap">
        <div class="rise card card-ink flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-2xl">
            <h2 class="title-sm">{ui.ctaTitle}</h2>
            <p class="lead mt-4">{ui.ctaText}</p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={`https://cal.com/${calLink}`} target="_blank" rel="noopener" data-umami-event="portfolio-cal" class="btn btn-invert btn-lg"><Icon name="calendar" />{ui.ctaCal}</a>
            <a href={`tel:${phone.href}`} data-umami-event="portfolio-call" class="btn btn-secondary btn-lg"><Icon name="phone" />{ui.ctaPhone}</a>
            <a href={`https://wa.me/${phone.href.slice(1)}`} target="_blank" rel="noopener" data-umami-event="portfolio-whatsapp" class="btn btn-secondary btn-lg"><Icon name="message" />{ui.ctaWa}</a>
          </div>
        </div>
      </div>
    </section>

    <dialog id="shot-viewer" class="viewer" aria-label={ui.zoom}>
      <form method="dialog"><button class="viewer-close btn btn-secondary btn-sm" aria-label={ui.close}><Icon name="x" /></button></form>
      <img alt="" />
    </dialog>
  </div>
</Layout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "head" "media" "body";
    gap: 2.5rem;
  }
  .p-head { grid-area: head; }
  .p-media { grid-area: media; }
  .p-body { grid-area: body; }
  @media (min-width: 1024px) {
    .project-grid {
      grid-template-columns: 5fr 7fr;
      grid-template-areas: "head media" "body media";
      grid-template-rows: auto 1fr;
      column-gap: 3.5rem;
      row-gap: 2rem;
    }
    .p-media > * {
      position: relative;
    }
    .p-media {
      align-self: start;
      position: sticky;
      top: 6rem;
    }
  }
  .stage {
    position: relative;
    padding: 0 0 2.5rem 0;
  }
  .shot {
    display: block;
    cursor: zoom-in;
    border-radius: 1rem;
    overflow: hidden;
    background: var(--canvas);
    box-shadow: var(--shadow-float);
    transition: transform 0.3s var(--ease);
  }
  .shot:hover {
    transform: translateY(-3px);
