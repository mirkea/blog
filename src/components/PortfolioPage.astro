---
import Layout from "../layouts/Layout.astro";
import Icon from "./ui/Icon.astro";

// Hidden portfolio: noindex, out of the sitemap, linked from nowhere. Sent by hand to leads.
// Pitches what he does, never results or numbers (kitchen career decision, 17.Nov.2026).
// Romanian is the default and has no diacritics on purpose. ZDAP stays unnamed until he says otherwise.
interface Props {
  lang: "ro" | "en";
}
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const calLink = "braescu-mircea/15min";
const phone = { href: "+40741141095", ro: "0741 141 095", en: "+40 741 141 095" };

type Project = {
  slug: string;
  name: string;
  url?: string;
  status: string;
  period: string;
  what: string;
  forWho: string;
  does: string;
  did: string[];
  tech: string;
  privateNote?: string;
  role: string;
  client?: string;
  shots: string[]; // after the cover (desktop-1) and the phone (mobile-1)
};

const ui = {
  ro: {
    title: "Portofoliu | Mircea Braescu",
    description: "Proiecte recente: magazine online, aplicatii web si mobile, SEO. Ce face fiecare, pentru cine si ce am facut eu.",
    switchHref: `${base}en/portfolio`,
    switchLabel: "English",
    eyebrow: "Portofoliu",
    h1: "Proiecte recente",
    h1b: "si ce am facut in fiecare.",
    lead: "Inteleg ce ai nevoie si construiesc solutia potrivita: site-uri si magazine online, SEO, aplicatii web si mobile facute pe masura.",
    role: "Rolul meu",
    client: "Client",
    about: "Sunt Mircea Braescu. Lucrez in software de 20 de ani, ca product manager, designer si programator; am fost PM pe verified.eu. Iau un proiect de la prima discutie pana la lansare.",
    ai: "Lucrez cu agenti AI, care scriu codul repede. Designul, arhitectura si calitatea raman responsabilitatea mea.",
    linkedin: "Profilul meu pe LinkedIn",
    forWho: "Pentru cine",
    does: "Ce face",
    did: "Ce am facut",
    tech: "Tehnologii",
    visit: "Deschide",
    zoom: "Mareste imaginea",
    close: "Inchide",
    ctaTitle: "Ai o idee sau o problema in firma?",
    ctaText: "Spune-mi ce ai nevoie. In 15 minute vedem impreuna daca si cum te pot ajuta.",
    ctaCal: "Programeaza 15 minute",
    ctaPhone: phone.ro,
    ctaWa: "WhatsApp",
  },
  en: {
    title: "Portfolio | Mircea Braescu",
    description: "Recent projects: online shops, web and mobile apps, SEO. What each one does, who it is for and what I did.",
    switchHref: `${base}portofoliu`,
    switchLabel: "Romana",
    eyebrow: "Portfolio",
    h1: "Recent projects",
    h1b: "and what I did on each.",
    lead: "I work out what you need and build the right thing for it: websites and online shops, SEO, custom web and mobile apps.",
    role: "My role",
    client: "Client",
    about: "I'm Mircea Braescu. I've worked in software for 20 years as a product manager, designer and developer; I was a PM on verified.eu. I take a project from the first conversation to launch.",
    ai: "I work with AI agents that write code fast. The design, the architecture and the quality stay my responsibility.",
    linkedin: "My LinkedIn profile",
    forWho: "Who it is for",
    does: "What it does",
    did: "What I did",
    tech: "Stack",
    visit: "Open",
    zoom: "Enlarge image",
    close: "Close",
    ctaTitle: "Have an idea or a problem in your business?",
    ctaText: "Tell me what you need. In 15 minutes we see together whether and how I can help.",
    ctaCal: "Book 15 minutes",
    ctaPhone: phone.en,
    ctaWa: "WhatsApp",
  },
}[lang];

const projects: Record<"ro" | "en", Project[]> = {
  ro: [
    {
      slug: "acomag",
      client: "Un antreprenor din Matca, Galati, cu firma lui de accesorii pentru acoperisuri.",
