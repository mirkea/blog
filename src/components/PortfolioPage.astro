// Short start month for the project pills, from "din aprilie 2026" / "since April 2026".
const month = (period: string) => {
  const m = period.split(" ").slice(-2)[0].toLowerCase();
  const short: Record<string, string> = { aprilie: "apr", mai: "mai", octombrie: "oct", noiembrie: "nov", april: "Apr", may: "May", october: "Oct", november: "Nov" };
  return short[m] ?? m.slice(0, 3);
};

