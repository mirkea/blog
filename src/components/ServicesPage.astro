                </div>
                <input id="calc-hours" type="range" min="1" max="60" step="1" value="10" class="range mt-2" />
              </div>
              <div class="field">
                <label for="calc-rate" class="label">{copy.calcRate}</label>
                <div class="flex items-center gap-3">
                  <input id="calc-rate" type="number" inputmode="decimal" min="0" step="5" value={copy.calcRateDefault} class="input tabular-nums" />
                  <span class="body">{copy.calcCurrency}</span>
                </div>
              </div>
            </div>
            <div class="flex flex-col justify-between gap-8">
              <div>
                <p class="body">{copy.calcResult}</p>
                <p class="title mt-2 tabular-nums"><span id="calc-result">0</span> <span class="tone-2">{copy.calcCurrency}</span></p>
                <p class="body mt-1">{copy.calcPerYear}</p>
              </div>
              <a href="#call" id="calc-cta" data-umami-event="calc-cta" class="btn btn-invert btn-lg self-start">{copy.calcCta}<Icon name="arrow-right" /></a>
            </div>
          </div>
          <hr class="divider mt-12" />
          <p class="caption mt-6">{copy.calcNote}</p>
        </div>
