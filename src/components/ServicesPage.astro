          >
            {copy.calButton}
            <ArrowRight size={18} class="transition-transform duration-200 group-hover:translate-x-1" />
          </a>
        </div>

        <div class="mb-10 grid grid-cols-2 gap-3">
          <a
            href={`tel:${phone.href}`}
            class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-lg border border-zinc-300 px-4 py-3 text-base font-semibold text-zinc-900 transition-colors duration-200 hover:border-zinc-900 dark:border-zinc-600 dark:text-zinc-100 dark:hover:border-zinc-100"
          >
            <Phone size={18} />
            <span>{copy.callLabel}<span class="hidden sm:inline">: {phone[lang]}</span></span>
          </a>
          <a
            href={`https://wa.me/${phone.href.slice(1)}`}
