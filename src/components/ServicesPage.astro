            rel="noopener"
            class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-lg border border-zinc-300 px-4 py-3 text-base font-semibold text-zinc-900 transition-colors duration-200 hover:border-zinc-900 dark:border-zinc-600 dark:text-zinc-100 dark:hover:border-zinc-100"
          >
            <MessageCircle size={18} />
            {copy.whatsappLabel}
          </a>
        </div>

        <p class="mb-6 font-medium text-zinc-900 dark:text-zinc-100">{copy.orForm}</p>

        <form
          id="lead-form"
          class="grid grid-cols-1 gap-5 sm:grid-cols-2"
          data-endpoint={leadsWorkerUrl}
          data-lang={lang}
          data-sending={copy.sending}
          data-success={copy.success}
          data-error={copy.error}
          data-mail-subject={copy.mailSubject}
          novalidate
        >
          <div>
            <label for="lead-name" class={labelClass}>{copy.fields.name}</label>
            <input id="lead-name" name="name" type="text" autocomplete="name" required class={inputClass} />
          </div>
          <div>
            <label for="lead-phone" class={labelClass}>{copy.fields.phone}</label>
            <input id="lead-phone" name="phone" type="tel" autocomplete="tel" required class={inputClass} />
          </div>
          <details class="details group sm:col-span-2">
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center gap-2 font-medium text-zinc-700 dark:text-zinc-300">
              <span class="details-plus inline-block w-4 text-center font-mono">+</span>
              {copy.moreDetails}
            </summary>
            <div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label for="lead-company" class={labelClass}>{copy.fields.company}</label>
              <input id="lead-company" name="company" type="text" autocomplete="organization" class={inputClass} />
            </div>
            <div>
              <label for="lead-email" class={labelClass}>{copy.fields.email}</label>
              <input id="lead-email" name="email" type="email" autocomplete="email" class={inputClass} />
            </div>
            <fieldset class="sm:col-span-2">
              <legend class={labelClass}>{copy.fields.interest}</legend>
              <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:gap-3">
                {
                  copy.fields.interestOptions.map((option, index) => (
                    <label class="interest-option flex min-h-[44px] cursor-pointer items-center gap-2 rounded-lg border border-zinc-200 px-4 text-zinc-700 transition-colors duration-200 hover:border-zinc-400 dark:border-zinc-700 dark:text-zinc-300">
                      <input
                        type="radio"
                        name="interest"
                        value={option}
                        checked={index === 2}
                        class="h-4 w-4 accent-zinc-900 dark:accent-zinc-100"
                      />
                      {option}
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <div class="sm:col-span-2">
              <label for="lead-message" class={labelClass}>{copy.fields.message}</label>
              <textarea
                id="lead-message"
                name="message"
                rows="4"
                placeholder={copy.fields.messagePlaceholder}
                class={inputClass}></textarea>
            </div>
            </div>
          </details>
          <input type="hidden" name="hours_per_week" id="lead-hours" />
          <input type="hidden" name="hourly_cost" id="lead-rate" />
          <input type="hidden" name="yearly_savings" id="lead-savings" />
          <!-- Honeypot: real people never see or fill this -->
          <div class="hidden" aria-hidden="true">
            <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="mb-2 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">{copy.safety}</p>
              <p class="text-sm text-zinc-500 dark:text-zinc-400">{copy.consent}</p>
            </div>
            <button
              type="submit"
              class="inline-flex min-h-[52px] cursor-pointer items-center justify-center rounded-lg bg-zinc-900 px-8 py-3 text-base font-semibold text-zinc-100 transition-all duration-200 hover:-translate-y-0.5 hover:bg-zinc-700 disabled:opacity-60 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
            >
              {copy.submit}
            </button>
          </div>
          <p id="lead-status" role="status" class="text-base font-medium text-zinc-900 sm:col-span-2 dark:text-zinc-100"></p>
        </form>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Wide sections break out of the blog's narrow column */
  .bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  .hero-glow {
    background:
      radial-gradient(40rem 24rem at 80% 30%, rgb(228 228 231 / 0.7), transparent 70%),
      radial-gradient(30rem 20rem at 10% 90%, rgb(244 244 245 / 0.9), transparent 70%);
  }

  :global(.dark) .hero-glow {
    background:
      radial-gradient(40rem 24rem at 80% 30%, rgb(63 63 70 / 0.5), transparent 70%),
      radial-gradient(30rem 20rem at 10% 90%, rgb(39 39 42 / 0.6), transparent 70%);
  }

  .calc-grid {
    background-image:
      linear-gradient(currentColor 1px, transparent 1px),
      linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .calc-range {
    accent-color: #f4f4f5;
  }

  :global(.dark) .calc-range {
    accent-color: #18181b;
  }

  .example-panel {
    transition: opacity 0.4s ease;
  }

  .example-panel.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .example-tab[aria-selected="true"] {
    background: var(--color-zinc-900);
    border-color: var(--color-zinc-900);
    color: var(--color-zinc-100);
  }

  :global(.dark) .example-tab[aria-selected="true"] {
    background: var(--color-zinc-100);
    border-color: var(--color-zinc-100);
    color: var(--color-zinc-900);
  }

  .details[open] .details-plus {
    transform: rotate(45deg);
  }

  .details-plus {
    transition: transform 0.2s ease;
  }

  .interest-option:has(input:checked) {
    border-color: currentColor;
  }

  .lift {
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease;
  }

  .lift:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -20px rgb(24 24 27 / 0.25);
  }

  /* Side buttons of the phone frame, phones only */
  @media (max-width: 639px) {
    .example-frame::before,
    .example-frame::after {
      content: "";
      position: absolute;
      width: 3px;
      border-radius: 2px;
      background: #27272a;
    }
    .example-frame::before {
      left: -13px;
      top: 110px;
      height: 56px;
      box-shadow: 0 -40px 0 -10px #27272a;
    }
    .example-frame::after {
      right: -13px;
      top: 140px;
      height: 80px;
    }
  }

  .hero-underline {
    transform: scaleX(0);
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.4s;
  }

  .is-visible .hero-underline {
    transform: scaleX(1);
  }

  .pulse-dot {
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .hero-underline {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .pulse-dot {
      animation: none;
    }
  }
</style>

<script>
  function setupServicesPage() {
    const sections = document.querySelectorAll(".services-page .reveal");
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 },
      );
      sections.forEach((section) => observer.observe(section));
    } else {
      sections.forEach((section) => section.classList.add("is-visible"));
    }

    const examples = document.getElementById("examples");
    if (examples && !examples.dataset.ready) {
      examples.dataset.ready = "true";
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const keys = [...examples.querySelectorAll<HTMLElement>("[data-panel]")].map((el) => el.dataset.panel || "");
      const fromAd = new URLSearchParams(window.location.search).get("exemplu");
      // Phones get the portrait screens, larger screens the desktop ones (same breakpoint as sm:).
      const wide = window.matchMedia("(min-width: 640px)");
      let inView = false;
      const show = (key: string) => {
        examples.querySelectorAll<HTMLElement>("[data-example]").forEach((tab) => {
          tab.setAttribute("aria-selected", String(tab.dataset.example === key));
        });
        examples.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
          const active = panel.dataset.panel === key;
          panel.classList.toggle("is-hidden", !active);
          const size = wide.matches ? "desktop" : "mobile";
          panel.querySelectorAll<HTMLVideoElement>("video").forEach((video) => {
            if (active && inView && !reduce && video.dataset.size === size) {
              video.currentTime = 0;
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
          if (active) {
            const url = examples.querySelector("[data-example-url]");
            if (url) url.textContent = panel.dataset.url || "";
          }
        });
        examples.querySelectorAll<HTMLElement>("[data-caption]").forEach((caption) => {
          caption.classList.toggle("hidden", caption.dataset.caption !== key);
        });
      };
      let current = fromAd && keys.includes(fromAd) ? fromAd : examples.dataset.default || keys[0];
      // Ads promise different things: swap in the headline the ad led with.
      const title = document.getElementById("hero-title");
      const heroes = JSON.parse(title?.dataset.heroes || "{}");
      if (title && fromAd && heroes[fromAd]) {
        const a = title.querySelector("[data-h1a]");
        const b = title.querySelector("[data-h1b]");
        if (a) a.textContent = heroes[fromAd].h1a;
        if (b) b.textContent = heroes[fromAd].h1b;
      }
      // Radu (ad D) came for the AI-built app rescue: show that card first.
      const grid = document.getElementById("services-grid");
      const rescue = grid?.querySelector('[data-service="2"]');
      if (fromAd === "inchirieri" && grid && rescue) {
        grid.prepend(rescue);
        grid.querySelectorAll("[data-num]").forEach((num, i) => (num.textContent = String(i + 1)));
      }
      examples.querySelectorAll<HTMLElement>("[data-example]").forEach((tab) => {
        tab.addEventListener("click", () => {
          current = tab.dataset.example || current;
          show(current);
        });
      });
      // Each clip ends on its confirmation; hold it for a moment, then play the screen again.
      wide.addEventListener("change", () => show(current));
      examples.querySelectorAll<HTMLVideoElement>("video").forEach((video) => {
        video.addEventListener("ended", () => {
          setTimeout(() => {
            if (inView && !video.closest(".is-hidden") && video.dataset.size === (wide.matches ? "desktop" : "mobile")) {
              video.currentTime = 0;
              video.play().catch(() => {});
            }
          }, 2500);
        });
      });
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(
          (entries) => {
            inView = entries[0].isIntersecting;
            show(current);
          },
          { threshold: 0.2 },
        ).observe(examples);
      }
      show(current);
    }

    const calc = document.getElementById("savings-calc");
    const hoursInput = document.getElementById("calc-hours") as HTMLInputElement | null;
    const rateInput = document.getElementById("calc-rate") as HTMLInputElement | null;
    if (calc && hoursInput && rateInput && !calc.dataset.ready) {
      calc.dataset.ready = "true";
      const formatter = new Intl.NumberFormat(calc.dataset.locale, { maximumFractionDigits: 0 });
      const update = () => {
        const hours = Number(hoursInput.value) || 0;
        const rate = Math.max(0, Number(rateInput.value) || 0);
        const yearly = hours * rate * 48;
        const hoursOut = document.getElementById("calc-hours-out");
        const result = document.getElementById("calc-result");
        if (hoursOut) hoursOut.textContent = String(hours);
        if (result) {
          // Count up to the new total so the change is felt, not just read.
          const from = Number(result.dataset.value || 0);
          result.dataset.value = String(yearly);
          const start = performance.now();
          const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const step = (now: number) => {
            const t = reduce ? 1 : Math.min(1, (now - start) / 400);
            result.textContent = formatter.format(from + (yearly - from) * (1 - (1 - t) ** 3));
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
        // Carry the numbers into the form so the lead arrives with them.
        const currency = calc.dataset.currency || "";
        (document.getElementById("lead-hours") as HTMLInputElement).value = String(hours);
        (document.getElementById("lead-rate") as HTMLInputElement).value = `${rate} ${currency}`;
        (document.getElementById("lead-savings") as HTMLInputElement).value = `${formatter.format(yearly)} ${currency}`;
      };
      hoursInput.addEventListener("input", update);
      rateInput.addEventListener("input", update);
      update();
    }

    const form = document.getElementById("lead-form") as HTMLFormElement | null;
    if (!form || form.dataset.ready) return;
    form.dataset.ready = "true";

    const status = document.getElementById("lead-status");
    const button = form.querySelector("button[type=submit]") as HTMLButtonElement;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      data.lang = form.dataset.lang || "";
      data.page = window.location.pathname + window.location.search;

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        // No worker configured yet: hand the lead to the visitor's mail app instead.
        const body = Object.entries(data)
          .filter(([key, value]) => value && key !== "website")
          .map(([key, value]) => `${key}: ${value}`)
          .join("\n");
        window.location.href = `mailto:contact@mirkea.com?subject=${encodeURIComponent(form.dataset.mailSubject || "")}&body=${encodeURIComponent(body)}`;
        return;
      }

      button.disabled = true;
      if (status) status.textContent = form.dataset.sending || "";
      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        if (status) status.textContent = form.dataset.success || "";
        // Conversion events for analytics and, once added, the Meta pixel.
        (window as any).umami?.track?.("lead", { lang: data.lang, interest: data.interest });
        (window as any).fbq?.("track", "Lead");
      } catch {
        if (status) status.textContent = form.dataset.error || "";
      } finally {
        button.disabled = false;
      }
    });
  }

  document.addEventListener("DOMContentLoaded", setupServicesPage);
  document.addEventListener("astro:page-load", setupServicesPage);
</script>

<script is:inline>
  // Cal.com embed (official loader): the booking button opens a pop-up instead of a new tab.
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement("script")).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ["initNamespace", namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", "15min", { origin: "https://cal.com" });
  var calScript = document.querySelector('script[src="https://app.cal.com/embed/embed.js"]');
  if (calScript)
    calScript.addEventListener("load", function () {
      window.calEmbedReady = true;
    });
  Cal.ns["15min"]("ui", { layout: "month_view" });
  // A booking counts as a lead, same as a form submission.
  Cal.ns["15min"]("on", {
    action: "bookingSuccessful",
    callback: function () {
      if (window.umami && window.umami.track) window.umami.track("lead", { source: "cal" });
      if (window.fbq) window.fbq("track", "Lead");
    },
  });
  // The link stays a plain cal.com link if the embed never loads; once it has, open the pop-up instead.
  document.addEventListener("click", function (event) {
    var link = event.target.closest && event.target.closest("#cal-button");
    if (link && window.calEmbedReady) {
      event.preventDefault();
    }
  });
</script>
