  </div>
  <footer slot="footer" class="section section-tight border-t border-line">
    <div class="wrap flex flex-col gap-4 text-sm text-ink-2 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} MIRKEA INTERACTIVE S.R.L., {lang === "ro" ? "CUI" : "company ID"} 50876040. {copy.footerRights}</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="mailto:contact@mirkea.com" class="hover:text-ink">contact@mirkea.com</a>
        <a href={linkedin} target="_blank" rel="noopener" class="hover:text-ink">LinkedIn</a>
        <a href={copy.switchHref} hreflang={lang === "ro" ? "en" : "ro"} class="hover:text-ink">{copy.switchLabel}</a>
      </div>
    </div>
