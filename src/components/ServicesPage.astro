                <div class="flex flex-wrap items-center justify-between gap-3">
                  <span class="icon-tile"><Icon name={step.icon} /></span>
                  <span class="pill pill-quiet whitespace-nowrap">{step.time}</span>
                </div>
                <p class="caption mt-6">0{index + 1}</p>
                <h3 class="heading mt-1">{step.name}</h3>
                <p class="body mt-3">{step.text}</p>
                <p class="pt-6 text-[0.95rem] font-medium text-ink">{step.you}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- About -->
    <section id="despre" class="section scroll-mt-6">
      <div class="wrap rise grid items-start gap-10 md:grid-cols-[auto_1fr] md:gap-16">
        <img src={`${base}profile.webp`} alt="Mircea Braescu" width="176" height="176" class="size-32 rounded-full object-cover md:size-44" loading="lazy" />
        <div class="max-w-3xl">
          <h2 class="title">{copy.aboutTitle}</h2>
          <p class="lead mt-6">{copy.about}</p>
          <p class="mt-8 font-medium text-ink">{copy.projectsLead}</p>
          <ul class="checklist mt-3">
            {
              copy.projects.map((project) => (
                <li><Icon name="check" /><span><a href={project.url} target="_blank" rel="noopener" class="font-semibold text-ink underline underline-offset-4">{project.name}</a>{`: ${project.text}`}</span></li>
              ))
            }
          </ul>
          <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-2">
            <a href={`${base}about`} class="link-more">{copy.aboutLink}<Icon name="chevron-right" /></a>
            <a href={linkedin} target="_blank" rel="noopener" class="link-more">{copy.linkedinLabel}<Icon name="arrow-up-right" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Form -->
    <section id="call" data-track-view="contact" class="section section-surface scroll-mt-6">
      <div class="wrap">
        <header class="rise max-w-3xl">
          <h2 class="title">{copy.formTitle}</h2>
          <p class="lead mt-5">{copy.formLead}</p>
        </header>

        <div class="rise mt-12 grid gap-4 lg:grid-cols-[2fr_3fr]">
          <!-- Fastest path first: pick a slot, or call / WhatsApp -->
          <div class="card card-ink flex flex-col">
            <h3 class="heading">{copy.calTitle}</h3>
            <p class="body mt-2">{copy.calText}</p>
            <a
              href={`https://cal.com/${calLink}`}
              target="_blank"
              rel="noopener"
              id="cal-button"
              data-cal-link={calLink}
              data-cal-namespace="15min"
              data-cal-config='{"layout":"month_view"}'
              class="btn btn-invert btn-lg mt-8 self-start"
            >
              {copy.calButton}<Icon name="arrow-right" />
            </a>
            <div class="mt-auto pt-10">
              <hr class="divider mb-6" />
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-1">
                <a href={`tel:${phone.href}`} class="btn btn-secondary"><Icon name="phone" />{copy.callLabel}: {phone[lang]}</a>
                <a href={`https://wa.me/${phone.href.slice(1)}`} target="_blank" rel="noopener" class="btn btn-secondary"><Icon name="message" />{copy.whatsappLabel}</a>
              </div>
            </div>
          </div>

          <div class="card card-white">
            <p class="heading">{copy.orForm}</p>
            <form
              id="lead-form"
              class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2"
              data-endpoint={leadsWorkerUrl}
              data-lang={lang}
              data-sending={copy.sending}
              data-success={copy.success}
              data-error={copy.error}
              data-email-error={copy.emailError}
              data-mail-subject={copy.mailSubject}
              novalidate
            >
              <div class="field">
                <label for="lead-name" class="label">{copy.fields.name}</label>
                <input id="lead-name" name="name" type="text" autocomplete="name" required class="input" />
              </div>
              <div class="field">
                <label for="lead-phone" class="label">{copy.fields.phone}</label>
                <input id="lead-phone" name="phone" type="tel" autocomplete="tel" required class="input" />
              </div>
              <details class="disclosure disclosure-inline sm:col-span-2">
                <summary><Icon name="add-circle" />{copy.moreDetails}</summary>
                <div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2">
                  <div class="field">
                    <label for="lead-company" class="label">{copy.fields.company}</label>
                    <input id="lead-company" name="company" type="text" autocomplete="organization" class="input" />
                  </div>
                  <div class="field">
                    <label for="lead-email" class="label">{copy.fields.email}</label>
                    <input id="lead-email" name="email" type="email" autocomplete="email" class="input" />
                  </div>
                  <fieldset class="field sm:col-span-2">
                    <legend class="label mb-2">{copy.fields.interest}</legend>
                    <div class="options">
                      {
                        copy.fields.interestOptions.map((option, index) => (
                          <label class="option"><input type="radio" name="interest" value={option} checked={index === 2} />{option}</label>
                        ))
                      }
                    </div>
                  </fieldset>
                  <div class="field sm:col-span-2">
                    <label for="lead-message" class="label">{copy.fields.message}</label>
                    <textarea id="lead-message" name="message" rows="4" placeholder={copy.fields.messagePlaceholder} class="textarea"></textarea>
                  </div>
                </div>
              </details>
              <input type="hidden" name="hours_per_week" id="lead-hours" />
              <input type="hidden" name="hourly_cost" id="lead-rate" />
              <input type="hidden" name="yearly_savings" id="lead-savings" />
              <!-- Honeypot: real people never see or fill this -->
              <div class="hidden" aria-hidden="true">
                <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
              </div>
              <div class="sm:col-span-2">
                <button type="submit" class="btn btn-primary btn-lg disabled:opacity-60">{copy.submit}<Icon name="arrow-right" /></button>
              </div>
              <div class="sm:col-span-2">
                <p class="caption leading-relaxed">{copy.safety}</p>
                <p class="caption mt-2">{copy.consent}</p>
              </div>
              <p id="lead-status" role="status" class="font-medium text-ink empty:hidden sm:col-span-2"></p>
            </form>
            <div id="lead-done" hidden tabindex="-1" class="py-10 text-center outline-none">
              <span class="icon-tile mx-auto"><Icon name="check" /></span>
              <p class="title-sm mt-6">{copy.doneTitle}</p>
              <p class="body mx-auto mt-3 max-w-md">{copy.success}</p>
            </div>
          </div>
