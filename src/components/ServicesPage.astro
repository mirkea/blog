    proofItems: [
      { title: "Aplicatia, pe telefon", text: "Simpla de folosit, rapida, gandita pentru oameni care nu citesc instructiuni." },
      { title: "Fiecare flux, inainte de cod", text: "Fiecare pas pe care il face un utilizator, desenat si verificat inainte sa scriu o linie de cod." },
      { title: "Harta intregii aplicatii", text: "Toate paginile, ferestrele si emailurile, intr-un singur loc. Stiti exact ce primiti." },
    ],
    servicesTitle: "Cu ce va pot ajuta",
    services: [
      {
        icon: Bot,
        name: "AI in firma voastra",
        text: "Gasim orele pierdute pe emailuri, oferte, facturi si postari, apoi le automatizam cu instrumente care exista deja. Va arat cum sa le folositi, ca sa nu depindeti de mine.",
      },
      {
        icon: Smartphone,
        name: "Aplicatii web si mobile",
        text: "Cand chiar aveti nevoie de o aplicatie, o construiesc de la prima schita la lansare: web, mobil sau amandoua. Codul si datele raman ale voastre.",
      },
      {
        icon: Wrench,
        name: "Ati inceput deja o aplicatie?",
        text: "Ati facut un prototip cu AI sau cu o alta firma si s-a blocat? Il preiau, il repar si il duc in productie, fara sa o luati de la zero.",
      },
    ],
    priceNote: "O prima versiune de aplicatie porneste de obicei de la 3.000 EUR. Pretul exact il stiti inainte de orice linie de cod.",
    honestTitle: "Nu orice problema cere o aplicatie",
    honest:
      "Multe firme simt ca au nevoie de o aplicatie. Uneori un formular bun, o pagina de programari sau un instrument care exista deja rezolva aceeasi problema mai repede si mai ieftin. Daca asa e, va spun din primul apel.",
    calcTitle: "Cat va costa munca repetitiva?",
    calcLead:
      "Ganditi-va la ce se repeta in fiecare saptamana: emailuri, oferte, facturi, programari, postari, date copiate dintr-un loc in altul.",
    calcHours: "Ore pe saptamana in toata echipa",
    calcRate: "Cat costa o ora de lucru",
    calcCurrency: "lei",
    calcRateDefault: 100,
    calcLocale: "ro-RO",
    calcResult: "Ati putea economisi pana la",
    calcPerYear: "pe an",
    calcNote: "Calcul: ore pe saptamana x cost pe ora x 48 de saptamani lucratoare. In apel vedem cat din aceste ore se poate automatiza.",
    calcCta: "Vreau sa vad ce se poate automatiza",
    stepsTitle: "Cum lucrez",
    steps: [
      {
        icon: PhoneCall,
        name: "Apel gratuit, 15 minute",
        text: "Imi spuneti ce vreti sa rezolvati. Va spun daca va pot ajuta si cum.",
      },
      {
        icon: Search,
        name: "Analiza",
        text: "Ne uitam impreuna la cum lucrati azi si stabilim ce merita facut, cu un pret fix inainte de orice cod.",
      },
      {
        icon: Hammer,
        name: "Construim",
        text: "Livrez pe etape si vedeti fiecare pas. La final primiti tot: aplicatia, codul si instructiunile.",
      },
    ],
    aboutTitle: "Cine sunt",
    about:
      "Sunt Mircea Braescu. Am 20 de ani in software si 10 in product management: am fost delivery PM pe verified.eu, o platforma B2B vanduta pentru 31 mil. EUR, apoi CPO intr-un studio de produs. Lucrez zilnic cu AI, asa ca o aplicatie care dura luni cu o echipa intreaga o pot livra singur in cateva saptamani.",
    aboutLink: "Mai multe despre mine",
    formTitle: "Programeaza apelul gratuit",
    formLead: "Alegeti singuri o ora din calendar sau lasati-mi datele si va sun eu.",
    calTitle: "Alegeti o ora direct",
    calText: "15 minute, online. Vedeti orele libere si rezervati pe loc.",
    calButton: "Alege o ora in calendar",
    orForm: "Sau va sun eu, in cel mult o zi lucratoare:",
    callLabel: "Sunati-ma",
    whatsappLabel: "WhatsApp",
    moreDetails: "Adaugati detalii (optional)",
    fields: {
      name: "Nume",
      company: "Firma",
      phone: "Telefon",
      email: "Email",
      interest: "Ce va intereseaza",
      interestOptions: ["AI in firma", "O aplicatie web sau mobila", "Nu stiu inca"],
      message: "Ce vreti sa rezolvati?",
      messagePlaceholder: "De exemplu: pierdem mult timp cu programarile la telefon",
    },
    consent: "Folosesc datele doar ca sa va contactez despre aceasta cerere.",
    submit: "Trimite",
    sending: "Se trimite...",
    success: "Multumesc! Va sun in cel mult o zi lucratoare.",
    error: "Nu s-a putut trimite. Scrieti-mi direct la contact@mirkea.com.",
    mailSubject: "Apel gratuit",
  },
  en: {
    title: "AI and apps for small businesses | Mircea Braescu",
    description:
      "An honest answer on what is worth building for your business: a web or mobile app, an AI tool, or nothing new. The first 15-minute call is free.",
    switchLabel: "Romana",
    switchHref: `${base}servicii`,
    eyebrow: "AI and apps for small businesses",
    h1a: "Do you need an app?",
    h1b: "Or just less manual work?",
    lead: "An honest answer on what is worth building for your business: a web or mobile app, an AI tool, or nothing new. The first call, 15 minutes, is free.",
    cta: "Book the free call",
    ctaSecondary: "How I work",
    trust: ["20 years in software", "Former PM on verified.eu, acquired for 31M EUR", "Reply within one working day"],
    phoneChip: "Carvuu, built by me",
    proofEyebrow: "Proof",
    proofTitle: "Carvuu: an app I built on my own",
    proofLead:
      "Carvuu gives every car a public profile: its story, photos, notes left on the windshield and reminders for insurance and inspections. I took it from idea to production with AI. That's how I work for you too.",
    proofItems: [
      { title: "The app, on the phone", text: "Simple, fast, made for people who never read instructions." },
      { title: "Every flow, before any code", text: "Every step a user takes, drawn and checked before I write a line of code." },
      { title: "A map of the whole app", text: "Every page, sheet and email in one place. You know exactly what you get." },
    ],
    servicesTitle: "How I can help",
    services: [
      {
        icon: Bot,
        name: "AI in your business",
        text: "We find the hours lost to email, quotes, invoices and posts, then automate them with tools that already exist. I show you how to run them, so you don't depend on me.",
      },
      {
        icon: Smartphone,
        name: "Web and mobile apps",
        text: "When you really need an app, I build it from the first sketch to launch: web, mobile or both. The code and the data stay yours.",
      },
      {
        icon: Wrench,
        name: "Already started an app?",
        text: "Built a prototype with AI or with another firm and it got stuck? I take it over, fix it and get it to production, without starting from zero.",
      },
    ],
    priceNote: "A first version of an app usually starts at 3.000 EUR. You know the exact price before any code is written.",
    honestTitle: "Not every problem needs an app",
    honest:
      "Many businesses feel they need an app. Sometimes a good form, a booking page or a tool that already exists solves the same problem faster and for less. If that's the case, I'll tell you on the first call.",
    calcTitle: "What does repetitive work cost you?",
    calcLead:
      "Think of what repeats every week: email, quotes, invoices, bookings, posts, data copied from one place to another.",
    calcHours: "Hours per week, whole team",
    calcRate: "Cost of one working hour",
    calcCurrency: "EUR",
    calcRateDefault: 25,
    calcLocale: "en-GB",
    calcResult: "You could save up to",
    calcPerYear: "a year",
    calcNote: "Math: hours per week x cost per hour x 48 working weeks. On the call we look at how many of those hours can be automated.",
    calcCta: "Show me what can be automated",
    stepsTitle: "How I work",
    steps: [
      {
        icon: PhoneCall,
        name: "Free call, 15 minutes",
        text: "You tell me what you want to solve. I tell you whether I can help and how.",
      },
      {
        icon: Search,
        name: "Assessment",
        text: "We look at how you work today and agree on what's worth doing, at a fixed price, before any code.",
      },
      {
        icon: Hammer,
        name: "Build",
        text: "I deliver in stages and you see every step. At the end you get everything: the app, the code and the instructions.",
      },
    ],
    aboutTitle: "Who I am",
    about:
      "I'm Mircea Braescu. 20 years in software and 10 in product management: delivery PM on verified.eu, a B2B platform acquired for 31M EUR, then CPO at a product studio. I work with AI every day, so an app that used to take a team months I can deliver on my own in a few weeks.",
    aboutLink: "More about me",
    formTitle: "Book the free call",
    formLead: "Pick a time in my calendar yourself, or leave your details and I'll call you.",
    calTitle: "Pick a time now",
    calText: "15 minutes, online. See the free slots and book on the spot.",
    calButton: "Pick a time in my calendar",
    orForm: "Or I call you, within one working day:",
    callLabel: "Call me",
    whatsappLabel: "WhatsApp",
    moreDetails: "Add details (optional)",
    fields: {
      name: "Name",
      company: "Company",
      phone: "Phone",
      email: "Email",
      interest: "What are you interested in",
      interestOptions: ["AI in my business", "A web or mobile app", "Not sure yet"],
      message: "What do you want to solve?",
      messagePlaceholder: "For example: we lose a lot of time booking appointments by phone",
    },
    consent: "I use your details only to contact you about this request.",
    submit: "Send",
    sending: "Sending...",
    success: "Thank you! I'll call you within one working day.",
    error: "It couldn't be sent. Write to me directly at contact@mirkea.com.",
    mailSubject: "Free call",
  },
}[lang];

const inputClass =
  "w-full rounded-md border border-zinc-200 bg-white px-3 py-2.5 text-base text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 focus:outline-none dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100";
const labelClass = "mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300";
---

<Layout title={copy.title} description={copy.description} lang={lang}>
  <div class="services-page">
    <!-- Hero: copy left, a phone right. PLACEHOLDER: Carvuu screen until the fictional SMB app mock replaces it -->
    <section class="bleed relative -mt-12 overflow-hidden pt-10 pb-16 sm:pt-14 sm:pb-24">
      <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
        <div class="reveal">
          <div class="mb-6 flex items-center justify-between gap-4">
            <span class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white/80 px-3 py-1 text-xs font-medium tracking-wide text-zinc-600 uppercase backdrop-blur dark:border-zinc-700 dark:bg-zinc-900/60 dark:text-zinc-300">
              <span class="pulse-dot h-1.5 w-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100"></span>
              {copy.eyebrow}
            </span>
            <a
              href={copy.switchHref}
              hreflang={lang === "ro" ? "en" : "ro"}
              class="text-sm font-medium text-zinc-500 underline-offset-4 hover:text-zinc-900 hover:underline dark:text-zinc-400 dark:hover:text-zinc-100"
            >
              {copy.switchLabel}
            </a>
          </div>
          <h1 class="text-4xl leading-[1.05] font-extrabold tracking-tight text-zinc-900 sm:text-5xl lg:text-6xl dark:text-zinc-100">
            <span class="block">{copy.h1a}</span>
            <span class="relative mt-2 inline-block">
              {copy.h1b}
              <span class="hero-underline absolute -bottom-1 left-0 h-1.5 w-full origin-left bg-zinc-900 dark:bg-zinc-100"></span>
            </span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-600 sm:text-xl dark:text-zinc-400">
            {copy.lead}
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
            <a
              href="#call"
              class="group inline-flex min-h-[52px] items-center justify-center gap-2 rounded-lg bg-zinc-900 px-7 py-3 text-base font-semibold text-zinc-100 shadow-lg shadow-zinc-900/20 transition-all duration-200 hover:-translate-y-0.5 hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
            >
              {copy.cta}
              <ArrowRight size={18} class="transition-transform duration-200 group-hover:translate-x-1" />
            </a>
            <a
              href="#savings"
              class="inline-flex min-h-[44px] items-center justify-center text-sm font-medium text-zinc-900 underline-offset-4 hover:underline dark:text-zinc-100"
            >
              {copy.calcTitle}
            </a>
          </div>
          <ul class="mt-10 flex flex-col gap-2 text-sm text-zinc-600 sm:flex-row sm:flex-wrap sm:gap-x-6 dark:text-zinc-400">
            {
              copy.trust.map((item) => (
                <li class="flex items-center gap-2">
                  <Check size={16} class="shrink-0 text-zinc-900 dark:text-zinc-100" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal relative mx-auto w-full max-w-[300px] lg:max-w-[320px]">
          <div class="phone float-slow relative">
            <div class="overflow-hidden rounded-[2.6rem] border-[10px] border-zinc-900 bg-zinc-900 shadow-2xl shadow-zinc-900/30 dark:border-zinc-700">
              <img
                src={`${base}services/carvuu-car.webp`}
                alt="Carvuu"
                width="800"
                height="1824"
                class="aspect-[9/17] w-full object-cover object-top"
                loading="eager"
              />
            </div>
          </div>
          <div class="chip chip-late absolute -right-4 bottom-12 rounded-lg bg-zinc-900 px-4 py-3 text-sm font-medium text-zinc-100 shadow-xl sm:-right-10 dark:bg-zinc-100 dark:text-zinc-900">
            {copy.phoneChip}
          </div>
        </div>
      </div>
    </section>

    <!-- Honest note -->
    <section class="reveal py-14 sm:py-20">
      <p class="mb-4 text-sm font-medium tracking-wide text-zinc-500 uppercase dark:text-zinc-400">
        {copy.honestTitle}
      </p>
      <p class="text-2xl leading-snug font-semibold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-100">
        {copy.honest}
      </p>
    </section>

    <!-- Services -->
    <section class="reveal pb-14 sm:pb-20">
      <h2 class="mb-10 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
        {copy.servicesTitle}
      </h2>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {
          copy.services.map((service, index) => (
            <div class={`lift group relative overflow-hidden rounded-xl border border-zinc-200 bg-white p-7 dark:border-zinc-700 dark:bg-zinc-800/60 ${index === 2 ? "sm:col-span-2" : ""}`}>
              <span class="pointer-events-none absolute -top-6 -right-2 font-mono text-[7rem] leading-none font-bold text-zinc-100 transition-colors duration-300 group-hover:text-zinc-200 dark:text-zinc-800 dark:group-hover:text-zinc-700">
                {index + 1}
              </span>
              <div class="relative">
                <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-lg bg-zinc-900 text-zinc-100 dark:bg-zinc-100 dark:text-zinc-900">
                  <service.icon size={22} />
                </div>
                <h3 class="mb-3 text-xl font-semibold text-zinc-900 dark:text-zinc-100">{service.name}</h3>
                <p class="leading-relaxed text-zinc-600 dark:text-zinc-400">{service.text}</p>
              </div>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-zinc-600 dark:text-zinc-400">{copy.priceNote}</p>
    </section>

    <!-- Savings calculator: same math as the internal pricer (hours x hourly cost x 48 weeks) -->
    <section id="savings" class="reveal scroll-mt-24 pb-14 sm:pb-20">
      <div
        id="savings-calc"
        class="relative overflow-hidden rounded-2xl bg-zinc-900 p-7 text-zinc-100 sm:p-10 dark:bg-zinc-100 dark:text-zinc-900"
        data-currency={copy.calcCurrency}
        data-locale={copy.calcLocale}
      >
        <div class="calc-grid pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true"></div>
        <div class="relative">
          <h2 class="mb-2 text-3xl font-bold tracking-tight sm:text-4xl">{copy.calcTitle}</h2>
          <p class="mb-10 max-w-xl text-zinc-400 dark:text-zinc-600">{copy.calcLead}</p>
          <div class="grid grid-cols-1 gap-10 sm:grid-cols-2">
            <div class="flex flex-col gap-8">
              <div>
                <div class="mb-3 flex items-baseline justify-between gap-4">
                  <label for="calc-hours" class="text-sm font-medium text-zinc-300 dark:text-zinc-700">{copy.calcHours}</label>
                  <output id="calc-hours-out" for="calc-hours" class="font-mono text-2xl font-bold">10</output>
                </div>
                <input id="calc-hours" type="range" min="1" max="60" step="1" value="10" class="calc-range w-full cursor-pointer" />
              </div>
              <div>
                <label for="calc-rate" class="mb-3 block text-sm font-medium text-zinc-300 dark:text-zinc-700">{copy.calcRate}</label>
                <div class="flex items-center gap-3">
                  <input
                    id="calc-rate"
                    type="number"
                    inputmode="decimal"
                    min="0"
                    step="5"
                    value={copy.calcRateDefault}
                    class="w-full rounded-md border border-zinc-700 bg-zinc-800 px-3 py-2.5 font-mono text-lg text-zinc-100 focus:border-zinc-100 focus:ring-1 focus:ring-zinc-100 focus:outline-none dark:border-zinc-300 dark:bg-white dark:text-zinc-900 dark:focus:border-zinc-900 dark:focus:ring-zinc-900"
                  />
                  <span class="text-zinc-400 dark:text-zinc-600">{copy.calcCurrency}</span>
                </div>
              </div>
            </div>
            <div class="flex flex-col justify-between gap-8">
              <div>
                <p class="text-sm text-zinc-400 dark:text-zinc-600">{copy.calcResult}</p>
                <p class="mt-2 text-5xl font-extrabold tracking-tight tabular-nums sm:text-6xl">
                  <span id="calc-result">0</span>
                  <span class="text-2xl font-bold text-zinc-400 sm:text-3xl dark:text-zinc-500">{copy.calcCurrency}</span>
                </p>
                <p class="mt-1 text-sm text-zinc-400 dark:text-zinc-600">{copy.calcPerYear}</p>
              </div>
              <a
                href="#call"
                id="calc-cta"
                class="group inline-flex min-h-[52px] items-center justify-center gap-2 rounded-lg bg-zinc-100 px-6 py-3 text-base font-semibold text-zinc-900 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-700"
              >
                {copy.calcCta}
                <ArrowRight size={18} class="transition-transform duration-200 group-hover:translate-x-1" />
              </a>
            </div>
          </div>
          <p class="mt-8 text-xs leading-relaxed text-zinc-500">{copy.calcNote}</p>
        </div>
      </div>
    </section>

    <!-- Proof: Carvuu, the phone screen plus the flow and app maps -->
    <section class="bleed bg-zinc-50 py-16 sm:py-24 dark:bg-zinc-800/40">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="reveal mb-12 max-w-2xl">
          <p class="mb-3 text-sm font-medium tracking-wide text-zinc-500 uppercase dark:text-zinc-400">{copy.proofEyebrow}</p>
          <h2 class="mb-4 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">{copy.proofTitle}</h2>
          <p class="text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">{copy.proofLead}</p>
        </div>
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[0.7fr_1.3fr]">
          <figure class="reveal lift flex flex-col justify-between rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-900">
            <div class="mx-auto my-auto w-full max-w-[260px] overflow-hidden rounded-[1.8rem] border-[7px] border-zinc-900 dark:border-zinc-700">
              <img src={`${base}services/carvuu-car.webp`} alt="" width="800" height="1824" class="aspect-[9/16] w-full object-cover object-top" loading="lazy" />
            </div>
            <figcaption class="mt-5">
              <p class="font-semibold text-zinc-900 dark:text-zinc-100">{copy.proofItems[0].title}</p>
              <p class="mt-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{copy.proofItems[0].text}</p>
            </figcaption>
          </figure>
          <div class="grid grid-cols-1 gap-6">
            {
              [
                { src: "services/carvuu-use-cases.webp", w: 1754, h: 1342, item: copy.proofItems[1] },
                { src: "services/carvuu-app-map.webp", w: 1992, h: 1577, item: copy.proofItems[2] },
              ].map((shot) => (
                <figure class="reveal lift overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-900">
                  <div class="flex items-center gap-1.5 border-b border-zinc-100 px-4 py-3 dark:border-zinc-800">
                    <span class="h-2.5 w-2.5 rounded-full bg-zinc-300 dark:bg-zinc-600" />
                    <span class="h-2.5 w-2.5 rounded-full bg-zinc-300 dark:bg-zinc-600" />
                    <span class="h-2.5 w-2.5 rounded-full bg-zinc-300 dark:bg-zinc-600" />
                  </div>
                  <a href={`${base}${shot.src}`} target="_blank" class="block overflow-hidden">
                    <img
                      src={`${base}${shot.src}`}
                      alt=""
