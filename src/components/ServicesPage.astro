            </div>
            </div>
          </details>
          <input type="hidden" name="hours_per_week" id="lead-hours" />
          <input type="hidden" name="hourly_cost" id="lead-rate" />
          <input type="hidden" name="yearly_savings" id="lead-savings" />
          <!-- Honeypot: real people never see or fill this -->
          <div class="hidden" aria-hidden="true">
            <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-zinc-500 dark:text-zinc-400">{copy.consent}</p>
            <button
              type="submit"
              class="inline-flex min-h-[52px] cursor-pointer items-center justify-center rounded-lg bg-zinc-900 px-8 py-3 text-base font-semibold text-zinc-100 transition-all duration-200 hover:-translate-y-0.5 hover:bg-zinc-700 disabled:opacity-60 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
            >
              {copy.submit}
            </button>
          </div>
          <p id="lead-status" role="status" class="text-base font-medium text-zinc-900 sm:col-span-2 dark:text-zinc-100"></p>
        </form>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Wide sections break out of the blog's narrow column */
  .bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  .hero-glow {
    background:
      radial-gradient(40rem 24rem at 80% 30%, rgb(228 228 231 / 0.7), transparent 70%),
      radial-gradient(30rem 20rem at 10% 90%, rgb(244 244 245 / 0.9), transparent 70%);
  }

  :global(.dark) .hero-glow {
    background:
      radial-gradient(40rem 24rem at 80% 30%, rgb(63 63 70 / 0.5), transparent 70%),
      radial-gradient(30rem 20rem at 10% 90%, rgb(39 39 42 / 0.6), transparent 70%);
  }

  .calc-grid {
    background-image:
      linear-gradient(currentColor 1px, transparent 1px),
      linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .calc-range {
    accent-color: #f4f4f5;
  }

  :global(.dark) .calc-range {
    accent-color: #18181b;
  }

  .details[open] .details-plus {
    transform: rotate(45deg);
  }

  .details-plus {
    transition: transform 0.2s ease;
  }

  .interest-option:has(input:checked) {
    border-color: currentColor;
  }

  .lift {
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease;
  }

  .lift:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -20px rgb(24 24 27 / 0.25);
  }

  .phone {
    transform: rotate(3deg);
  }

  .float-slow {
    animation: float 7s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: rotate(3deg) translateY(0);
    }
    50% {
      transform: rotate(3deg) translateY(-10px);
    }
  }

  .hero-underline {
    transform: scaleX(0);
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.4s;
  }

  .is-visible .hero-underline {
    transform: scaleX(1);
  }

  .chip {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.6s ease 0.6s,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.6s;
  }

  .chip-late {
    transition-delay: 0.9s;
  }

  .is-visible .chip {
    opacity: 1;
    transform: none;
  }

  .pulse-dot {
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
