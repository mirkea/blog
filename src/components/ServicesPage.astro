const labelClass = "mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300";
---

<Layout title={copy.title} description={copy.description} lang={lang}>
  <div class="services-page">
    <!-- Hero: copy, then the three example apps. Each ad links with ?exemplu=<key> to open its app first -->
    <section class="bleed relative -mt-12 overflow-hidden pt-10 pb-16 sm:pt-14 sm:pb-24">
      <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
        <div class="reveal max-w-3xl">
          <div class="mb-6 flex items-center justify-between gap-4">
            <span class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white/80 px-3 py-1 text-xs font-medium tracking-wide text-zinc-600 uppercase backdrop-blur dark:border-zinc-700 dark:bg-zinc-900/60 dark:text-zinc-300">
              <span class="pulse-dot h-1.5 w-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100"></span>
              {copy.eyebrow}
            </span>
            <a
              href={copy.switchHref}
              hreflang={lang === "ro" ? "en" : "ro"}
              class="text-sm font-medium text-zinc-500 underline-offset-4 hover:text-zinc-900 hover:underline dark:text-zinc-400 dark:hover:text-zinc-100"
            >
              {copy.switchLabel}
            </a>
          </div>
          <h1
            id="hero-title"
            data-heroes={JSON.stringify(copy.heroes)}
            class="text-[2rem] leading-[1.05] font-extrabold tracking-tight text-zinc-900 sm:text-5xl lg:text-6xl dark:text-zinc-100"
          >
            <span class="block" data-h1a>{copy.h1a}</span>
            <span class="relative mt-2 inline-block">
              <span data-h1b>{copy.h1b}</span>
              <span class="hero-underline absolute -bottom-1 left-0 h-1.5 w-full origin-left bg-zinc-900 dark:bg-zinc-100"></span>
            </span>
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-zinc-600 sm:mt-6 sm:text-xl dark:text-zinc-400">
            {copy.lead}
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:items-center sm:gap-4">
            <a
              href="#call"
              class="group inline-flex min-h-[52px] items-center justify-center gap-2 rounded-lg bg-zinc-900 px-7 py-3 text-base font-semibold text-zinc-100 shadow-lg shadow-zinc-900/20 transition-all duration-200 hover:-translate-y-0.5 hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
            >
              {copy.cta}
              <ArrowRight size={18} class="transition-transform duration-200 group-hover:translate-x-1" />
            </a>
            <div class="grid grid-cols-2 gap-3 sm:flex">
              <a
                href={`tel:${phone.href}`}
                data-umami-event="hero-call"
                class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-lg border border-zinc-300 bg-white/80 px-4 text-sm font-semibold text-zinc-900 transition-colors duration-200 hover:border-zinc-900 dark:border-zinc-600 dark:bg-zinc-900/60 dark:text-zinc-100 dark:hover:border-zinc-100"
              >
                <Phone size={16} />
                {copy.callLabel}
              </a>
              <a
                href={`https://wa.me/${phone.href.slice(1)}`}
                target="_blank"
                rel="noopener"
                data-umami-event="hero-whatsapp"
                class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-lg border border-zinc-300 bg-white/80 px-4 text-sm font-semibold text-zinc-900 transition-colors duration-200 hover:border-zinc-900 dark:border-zinc-600 dark:bg-zinc-900/60 dark:text-zinc-100 dark:hover:border-zinc-100"
              >
                <MessageCircle size={16} />
                {copy.whatsappLabel}
              </a>
            </div>
          </div>
          <a
            href="#savings"
            class="mt-3 inline-flex min-h-[44px] items-center text-sm font-medium text-zinc-900 underline underline-offset-4 sm:no-underline sm:hover:underline dark:text-zinc-100"
          >
            {copy.calcTitle}
          </a>
          <ul class="mt-10 hidden flex-col gap-2 text-sm text-zinc-600 sm:flex sm:flex-row sm:flex-wrap sm:gap-x-6 dark:text-zinc-400">
            {
              copy.trust.map((item) => (
                <li class="flex items-center gap-2">
                  <Check size={16} class="shrink-0 text-zinc-900 dark:text-zinc-100" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div id="examples" class="reveal mt-8 sm:mt-16" data-default={copy.examples[0].key}>
          <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <p class="text-sm font-medium tracking-wide text-zinc-500 uppercase dark:text-zinc-400">{copy.examplesLabel}</p>
            <div class="flex flex-wrap gap-2" role="tablist" aria-label={copy.examplesLabel}>
              {
                copy.examples.map((example, index) => (
                  <button
                    type="button"
                    role="tab"
                    id={`tab-${example.key}`}
                    aria-controls={`panel-${example.key}`}
                    aria-selected={index === 0 ? "true" : "false"}
                    data-example={example.key}
                    class="example-tab min-h-[44px] cursor-pointer rounded-full border border-zinc-300 px-4 text-sm font-medium text-zinc-700 transition-colors duration-200 hover:border-zinc-900 dark:border-zinc-600 dark:text-zinc-300 dark:hover:border-zinc-100"
                  >
                    {example.tab}
                  </button>
                ))
              }
            </div>
          </div>
