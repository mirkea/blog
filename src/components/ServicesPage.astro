        <div class="relative">
          <h2 class="mb-2 text-3xl font-bold tracking-tight sm:text-4xl">{copy.calcTitle}</h2>
          <p class="mb-10 max-w-xl text-zinc-400 dark:text-zinc-600">{copy.calcLead}</p>
          <div class="grid grid-cols-1 gap-10 sm:grid-cols-2">
            <div class="flex flex-col gap-8">
              <div>
                <div class="mb-3 flex items-baseline justify-between gap-4">
                  <label for="calc-hours" class="text-sm font-medium text-zinc-300 dark:text-zinc-700">{copy.calcHours}</label>
                  <output id="calc-hours-out" for="calc-hours" class="font-mono text-2xl font-bold">10</output>
                </div>
                <input id="calc-hours" type="range" min="1" max="60" step="1" value="10" class="calc-range w-full cursor-pointer" />
              </div>
              <div>
                <label for="calc-rate" class="mb-3 block text-sm font-medium text-zinc-300 dark:text-zinc-700">{copy.calcRate}</label>
                <div class="flex items-center gap-3">
                  <input
                    id="calc-rate"
                    type="number"
                    inputmode="decimal"
                    min="0"
                    step="5"
                    value={copy.calcRateDefault}
                    class="w-full rounded-md border border-zinc-700 bg-zinc-800 px-3 py-2.5 font-mono text-lg text-zinc-100 focus:border-zinc-100 focus:ring-1 focus:ring-zinc-100 focus:outline-none dark:border-zinc-300 dark:bg-white dark:text-zinc-900 dark:focus:border-zinc-900 dark:focus:ring-zinc-900"
                  />
                  <span class="text-zinc-400 dark:text-zinc-600">{copy.calcCurrency}</span>
                </div>
              </div>
            </div>
            <div class="flex flex-col justify-between gap-8">
              <div>
                <p class="text-sm text-zinc-400 dark:text-zinc-600">{copy.calcResult}</p>
