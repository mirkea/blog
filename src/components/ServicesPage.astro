---

<Layout title={copy.title} description={copy.description} lang={lang} landing wide>
  <div class="services-page">
    <!-- Hero: copy, then the three example apps. Each ad links with ?exemplu=<key> to open its app first -->
    <section class="section section-surface !pt-6 sm:!pt-8">
      <div class="wrap">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-4">
          <a href={Astro.url.pathname} class="flex shrink-0 items-center text-ink" aria-label="Mircea Braescu">
            <span class="inline-block size-8 [&>svg]:h-full [&>svg]:w-full" set:html={logoRaw} />
          </a>
          <span class="pill pill-float pill-dot order-last sm:order-none">{copy.eyebrow}</span>
          <a href={copy.switchHref} hreflang={lang === "ro" ? "en" : "ro"} class="link-underline ml-auto text-sm">
            {copy.switchLabel}
          </a>
        </div>

        <div class="rise mt-12 sm:mt-16">
          <h1 id="hero-title" data-heroes={JSON.stringify(copy.heroes)} class="display max-w-6xl">
            <span class="block" data-h1a>{copy.h1a}</span>
            <span class="tone-2 block"><span data-h1b>{copy.h1b}</span> <span data-h1u>{copy.h1u}</span></span>
          </h1>
          <p class="lead mt-6 max-w-2xl">{copy.lead}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
            <a href="#call" class="btn btn-primary btn-lg">{copy.cta}<Icon name="arrow-right" /></a>
            <div class="grid grid-cols-2 gap-3 sm:flex">
              <a href={`tel:${phone.href}`} data-umami-event="hero-call" class="btn btn-secondary btn-lg whitespace-nowrap"><Icon name="phone" />{copy.callLabel}</a>
              <a href={`https://wa.me/${phone.href.slice(1)}`} target="_blank" rel="noopener" data-umami-event="hero-whatsapp" class="btn btn-secondary btn-lg whitespace-nowrap"><Icon name="message" />{copy.whatsappLabel}</a>
            </div>
          </div>
          <a href="#savings" data-umami-event="hero-calc" class="link-more mt-5">{copy.calcTitle}<Icon name="chevron-right" /></a>
          <ul class="checklist mt-10 hidden sm:flex sm:flex-row sm:flex-wrap sm:gap-x-8">
            {copy.trust.map((item) => <li><Icon name="check" /><span>{item}</span></li>)}
            <li><Icon name="check" /><a href="#despre" class="hover:underline hover:underline-offset-4">{copy.trustWork}</a></li>
          </ul>
        </div>

        <div id="examples" class="rise mt-14 sm:mt-20" data-default={copy.examples[0].key}>
          <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="eyebrow">{copy.examplesLabel}</p>
            <div class="seg self-start" role="tablist" aria-label={copy.examplesLabel}>
              {
                copy.examples.map((example, index) => (
                  <button
                    type="button"
                    role="tab"
                    id={`tab-${example.key}`}
                    aria-controls={`panel-${example.key}`}
                    aria-selected={index === 0 ? "true" : "false"}
                    data-example={example.key}
                    data-umami-event="example-tab"
                    data-umami-event-tab={example.key}
                    class="seg-item"
                  >
                    {example.tab}
                  </button>
                ))
              }
            </div>
          </div>
          <!-- Phones: an iPhone-style frame around the portrait screens. From sm up: a browser window around the desktop ones -->
          <div class="example-frame relative mx-auto max-w-[330px] rounded-[3rem] border-[10px] border-[#1d1d1f] bg-[#1d1d1f] [box-shadow:var(--shadow-float)] sm:max-w-none sm:rounded-card sm:border-0 sm:bg-canvas">
            <div class="overflow-hidden rounded-[2.3rem] sm:rounded-card">
              <div class="relative flex h-9 items-center justify-between bg-[#1d1d1f] px-6 text-[13px] font-semibold text-white sm:hidden" aria-hidden="true">
                <span>9:41</span>
                <span class="absolute top-2 left-1/2 h-[22px] w-[88px] -translate-x-1/2 rounded-full bg-black"></span>
                <span class="flex items-center gap-1">
                  <svg width="17" height="11" viewBox="0 0 17 11" fill="currentColor"><rect x="0" y="7" width="3" height="4" rx="1" /><rect x="4.5" y="5" width="3" height="6" rx="1" /><rect x="9" y="2.5" width="3" height="8.5" rx="1" /><rect x="13.5" y="0" width="3" height="11" rx="1" /></svg>
                  <svg width="24" height="11" viewBox="0 0 24 11" fill="none"><rect x="0.5" y="0.5" width="20" height="10" rx="3" stroke="currentColor" opacity="0.4" /><rect x="2" y="2" width="15" height="7" rx="1.6" fill="currentColor" /><rect x="21.5" y="3.5" width="1.5" height="4" rx="0.75" fill="currentColor" opacity="0.4" /></svg>
                </span>
              </div>
              <div class="hidden items-center gap-1.5 border-b border-line px-5 py-3.5 sm:flex">
                <span class="h-2.5 w-2.5 rounded-full bg-surface-2"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-surface-2"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-surface-2"></span>
                <span class="caption ml-3 font-mono" data-example-url>{copy.examples[0].url}</span>
              </div>
              <div class="relative aspect-[9/16] bg-surface sm:aspect-[16/10]">
                <!-- Shown only with "reduce motion": the clips wait for a tap instead of autoplaying -->
                <button type="button" data-example-play data-umami-event="example-play" hidden class="btn btn-primary absolute bottom-4 left-1/2 z-10 -translate-x-1/2">
                  <Icon name="play" variant="bold" />
                  {copy.examplesPlay}
                </button>
                {
                  copy.examples.map((example, index) => (
                    <div
                      id={`panel-${example.key}`}
                      role="tabpanel"
                      aria-labelledby={`tab-${example.key}`}
                      data-panel={example.key}
                      data-url={example.url}
                      class={`example-panel absolute inset-0 ${index === 0 ? "" : "is-hidden"}`}
                    >
                      <video class="hidden h-full w-full object-cover sm:block" data-size="desktop" poster={`${base}services/examples/${example.image}`} muted playsinline preload="none" aria-label={example.alt}>
                        <source src={`${base}services/examples/${example.video}`} type="video/mp4" />
                      </video>
                      <video class="h-full w-full object-cover sm:hidden" data-size="mobile" poster={`${base}services/examples/${example.mobileImage}`} muted playsinline preload="none" aria-label={example.alt}>
                        <source src={`${base}services/examples/${example.mobileVideo}`} type="video/mp4" />
                      </video>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
          <p class="body mt-5 max-w-3xl text-[0.95rem]">
            {
              copy.examples.map((example, index) => (
                <span data-caption={example.key} class={index === 0 ? "" : "hidden"}>
                  <span class="font-semibold text-ink">{example.name}.</span> {example.caption}
                </span>
              ))
            }
            <span class="text-ink-3"> {copy.examplesNote}</span>
          </p>
          <ul class="checklist mt-6 sm:hidden">
            {copy.trust.map((item) => <li><Icon name="check" /><span>{item}</span></li>)}
            <li><Icon name="check" /><a href="#despre" class="underline underline-offset-4">{copy.trustWork}</a></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Honest note -->
    <section class="section section-tight">
      <div class="wrap rise">
        <p class="eyebrow mb-4">{copy.honestTitle}</p>
        <p class="title-sm highlight max-w-4xl" set:html={copy.honest} />
      </div>
    </section>

    <!-- Services and prices -->
    <section class="section !pt-0">
      <div class="wrap">
        <h2 class="title rise">{copy.servicesTitle}</h2>
        <div id="services-grid" class="rise mt-12 grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-y-0">
          {
            copy.services.map((service, index) => (
              <div data-service={index} class:list={["card flex flex-col md:row-span-3 md:grid md:grid-rows-subgrid md:gap-y-0", index === 0 && "card-ink"]}>
                <span class="icon-tile mb-6 self-start"><Icon name={service.icon} /></span>
                <h3 class="heading">{service.name}</h3>
                <p class="body mt-3">{service.text}</p>
              </div>
            ))
          }
        </div>

        <div class="rise mt-16 grid gap-10 lg:grid-cols-[2fr_3fr]" data-track-view="prices">
          <div>
            <h3 class="title-sm">{copy.priceTitle}</h3>
            {copy.priceExample.map((line) => <p class="body mt-4">{line}</p>)}
          </div>
          <div>
            <dl class="rows">
              {copy.prices.map((price) => <div><dt>{price.name}</dt><dd>{price.value}</dd></div>)}
            </dl>
            <ul class="checklist mt-8">
              {copy.priceFoot.map((line) => <li><Icon name="check" /><span>{line}</span></li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Savings calculator: same math as the internal pricer (hours x hourly cost x 48 weeks) -->
    <section id="savings" data-track-view="calculator" class="section !pt-0 scroll-mt-6">
      <div class="wrap rise">
        <div id="savings-calc" class="card card-ink !p-[clamp(1.75rem,5vw,4.5rem)]" data-currency={copy.calcCurrency} data-locale={copy.calcLocale}>
          <h2 class="title">{copy.calcTitle}</h2>
          <p class="lead mt-5 max-w-2xl">{copy.calcLead}</p>
          <div class="mt-12 grid grid-cols-1 gap-x-16 gap-y-10 lg:grid-cols-2">
            <div class="grid content-start gap-8">
              <div class="field">
                <div class="flex items-baseline justify-between gap-4">
