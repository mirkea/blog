---
export interface Props {
  tags: string[];
  class?: string; // Add optional class prop
}

const { tags = [], class: className = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

{
  tags.length > 0 && (
    <div class={`flex flex-wrap gap-2 ${className}`}>
      {tags.map((tag) => (
        <a
          href={`${base}tags/${tag}`}
          class="pill no-underline"
        >
          #{tag}
        </a>
      ))}
    </div>
  )
}
