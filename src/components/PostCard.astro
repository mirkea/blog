---
import FormattedDate from "./FormattedDate.astro";
import Icon from "./ui/Icon.astro";

export interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  slug: string;
  readingTime?: string;
  tags?: string[];
  heroImage?: string;
  index?: number;
  tone?: "surface" | "white";
}

const {
  title,
  description,
  pubDate,
  slug,
  readingTime,
  tags = [],
  heroImage,
  index = 0,
  tone = "surface",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const estimatedReadingTime = readingTime ?? "5 min read";
---

<article class:list={["card card-link group flex h-full flex-col", tone === "white" && "card-white"]}>
  {
    heroImage && (
      <div class="-mx-2 -mt-2 mb-6 aspect-video overflow-hidden rounded-tile">
        <img
          src={heroImage}
          alt=""
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          loading={index === 0 ? "eager" : "lazy"}
          width="400"
          height="225"
        />
      </div>
    )
  }

  <p class="caption">
    <time datetime={pubDate.toISOString()}><FormattedDate date={pubDate} format="long" /></time>
    <span aria-hidden="true"> · </span>{estimatedReadingTime}
  </p>

  <h3 class="heading mt-3 !text-[1.35rem]">
    <a href={`${base}${slug}`} class="after:absolute after:inset-0 after:rounded-card">{title}</a>
  </h3>

  {description && <p class="mt-3 line-clamp-3 text-ink-2">{description}</p>}

  <div class="mt-auto flex items-center justify-between gap-4 pt-6">
    <div class="relative z-10 flex flex-1 flex-wrap gap-x-3 gap-y-1">
      {tags.slice(0, 3).map((tag) => <a href={`${base}tags/${tag}`} class="tag">#{tag}</a>)}
    </div>
    <Icon
      name="arrow-right"
      class="size-5 shrink-0 text-ink transition-transform duration-300 group-hover:translate-x-1"
    />
  </div>
</article>
