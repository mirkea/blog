---
export const prerender = true;
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";

const base = import.meta.env.BASE_URL;

// Get all published blog posts (drafts still visible in dev for previewing)
const allPosts = await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV);

// Get the 3 most recent posts
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Two offers, each with its own landing page. Founders first (his main goal). Copy mirrors those pages, in English.
const offers = [
  {
    key: "founders",
    tag: "For founders",
    title: "A technical co-founder for your product.",
    text: "I join you as technical co-founder and we start a new company for the product. I stay for the long run and look after the product, so you can focus on customers and sales.",
    points: ["I build at my cost, or you pay part for a smaller stake", "The code, data and accounts belong to the company, not to me", "At most 3 founders at a time"],
    cta: { text: "See the founder offer", href: `${base}fondatori` },
  },
  {
    key: "services",
    tag: "For small and mid-sized businesses",
    title: "AI and apps for your business.",
    text: "An honest answer on what is worth building for your business: a web or mobile app, an AI tool, or nothing new.",
    points: ["Web apps from €3,000, mobile apps from €5,000", "A fixed price before any code is written", "The first call, 15 minutes, is free"],
    cta: { text: "See services", href: `${base}en/services` },
  },
];

const proof = [
  { name: "verified.eu", text: "Delivery PM, 5+ years. B2B platform acquired for €31M.", href: "https://www.verified.eu/", cta: "Visit site" },
  { name: "Carvuu", text: "Social app for car owners. Idea to production in 2 months.", href: "https://carvuu.com", cta: "Visit site" },
  { name: "AcoMag", text: "Online shop. First version live in under a month, running 2+ years.", href: "https://acomag.ro", cta: "Visit site" },
  { name: "MiStuff", text: "My own tasks, notes and lists app. Built it, I use it every day.", href: "/blog/mistuff", cta: "The story" },
];

// Get all unique tags from posts
const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))].slice(0, 5);
---

<Layout title="Mirkea | PM by trade. Builder by choice." wide>
  <Section>
    <div class="rise grid items-center gap-10 md:grid-cols-[3fr_2fr] md:gap-16">
      <div class="order-2 text-center md:order-1 md:text-left">
        <p class="eyebrow mb-4">Mircea Braescu · Bucharest · Startup Wise Guys Founders Club</p>
        <h1 class="display !text-[clamp(2.6rem,6vw,5rem)]"><span class="block">PM by trade.</span><span class="tone-2 block">Builder by choice.</span></h1>
        <p class="lead mt-6 max-w-xl max-md:mx-auto">I help founders launch their product: I join as technical co-founder and build it with you, from the first screen to paying users. 10 years in product, 20 in software.</p>
        <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row md:justify-start sm:justify-center">
          <Button href="#work" size="lg" icon="arrow-right">Work with me</Button>
          <a href={`${base}about`} class="link-more">More about me <Icon name="chevron-right" /></a>
        </div>
      </div>
      <div class="order-1 md:order-2">
        <div class="mx-auto aspect-square w-full max-w-[200px] overflow-hidden rounded-card bg-surface sm:max-w-[280px] md:max-w-none">
          <img src="/profile.webp" alt="Mircea Braescu" class="h-full w-full object-cover" loading="eager" />
        </div>
      </div>
    </div>
    <div class="rise mt-16 grid gap-4 grid-cols-2 lg:grid-cols-4">
      {proof.map((p) => (
        <div class="card flex flex-col !py-6">
          <p class="heading !text-xl">{p.name}</p>
          <p class="caption mt-1">{p.text}</p>
          {p.href && <a href={p.href} class="link-more mt-auto pt-3">{p.cta} <Icon name="chevron-right" /></a>}
        </div>
      ))}
    </div>
  </Section>

  <Section id="work" tone="surface" data-track-view="home-offers">
    <SectionHeading title="Work with me." title2="Two ways in." align="left" />
    <!-- Both cards share rows, so tag, title, text, list and button line up -->
    <div class="rise mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-y-0">
      {
        offers.map((offer, index) => (
          <div class:list={["card flex flex-col !p-[clamp(1.75rem,4vw,3rem)] md:row-span-5 md:grid md:grid-rows-subgrid md:gap-y-0", index === 0 ? "card-ink" : "card-white"]}>
            <span class:list={["pill self-start justify-self-start", "pill-quiet"]}>{offer.tag}</span>
            <h3 class="title-sm mt-6">{offer.title}</h3>
            <p class="body mt-4">{offer.text}</p>
            <div class="mt-8">
              <hr class="divider mb-6" />
              <ul class="checklist">
                {offer.points.map((point) => <li><Icon name="check" /><span>{point}</span></li>)}
              </ul>
            </div>
            <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 self-end max-sm:w-full">
              <a href={offer.cta.href} data-umami-event="home-offer" data-umami-event-offer={offer.key} class:list={["btn btn-lg max-sm:w-full", index === 0 ? "btn-invert" : "btn-primary"]}>{offer.cta.text}<Icon name="arrow-right" /></a>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section>
    <div class="rise flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="title">Recent posts.</h2>
      <a href={`${base}blog`} class="link-more">View all posts <Icon name="chevron-right" /></a>
    </div>
    <div class="rise mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        recentPosts.map((post, index) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            readingTime={post.data.readingTime || `${Math.ceil(post.body.length / 2000)} min read`}
            tags={post.data.tags}
            heroImage={post.data.image}
            index={index}
          />
        ))
      }
    </div>
  </Section>

  {
    allTags.length > 0 && (
      <Section tone="surface">
        <div class="rise flex flex-wrap items-baseline justify-between gap-4">
          <h2 class="title">Explore topics.</h2>
          <a href={`${base}tags`} class="link-more">View all topics <Icon name="chevron-right" /></a>
        </div>
        <div class="rise mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {allTags.map((tag) => {
            const tagCount = allPosts.filter((post) => post.data.tags && post.data.tags.includes(tag)).length;
            return (
              <a href={`${base}tags/${tag}`} class="card card-white card-link flex items-center justify-between gap-4 !py-6">
                <div>
                  <p class="heading !text-xl">#{tag}</p>
                  <p class="caption mt-1">Explore articles about {tag}</p>
                </div>
                <span class="pill pill-quiet shrink-0">{tagCount} {tagCount === 1 ? "post" : "posts"}</span>
              </a>
            );
          })}
        </div>
      </Section>
    )
  }

  <script is:inline>
    // Umami: one "view-home-offers" event per visit when the offers section is first seen.
    (function () {
      var el = document.querySelector('[data-track-view="home-offers"]');
      if (!el || !("IntersectionObserver" in window)) return;
      var io = new IntersectionObserver(function (entries) {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        try {
          if (sessionStorage.getItem("view-home-offers")) return;
          sessionStorage.setItem("view-home-offers", "1");
        } catch (e) {}
        var send = function (tries) {
          if (window.umami && window.umami.track) window.umami.track("view-home-offers");
          else if (tries < 20) setTimeout(function () { send(tries + 1); }, 500);
        };
        send(0);
      }, { threshold: 0.3 });
      io.observe(el);
    })();
  </script>
</Layout>
