---
export const prerender = true;
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV);
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))];

// Most-used topics first
const sortedTags = tags
  .map((name) => ({ name, count: allPosts.filter((post) => post.data.tags?.includes(name)).length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const base = import.meta.env.BASE_URL;
---

<Layout title="Explore Tags" wide>
  <Section tight>
    <SectionHeading
      title="Explore topics."
      lead="Discover content organized by your interests"
      size="display"
      as="h1"
    />
  </Section>

  <Section tone="surface">
    {
      sortedTags.length === 0 ? (
        <div class="card card-white mx-auto max-w-lg text-center">
          <p class="heading">No tags found yet.</p>
          <p class="body mt-2">Check back later for categorized content.</p>
        </div>
      ) : (
        <>
          <h2 class="title-sm rise mb-8">Popular topics</h2>
          <div class="rise grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {sortedTags.map((tag) => (
              <a href={`${base}tags/${tag.name}`} class="card card-white card-link flex items-center justify-between gap-4 !py-6">
                <p class="heading min-w-0 truncate !text-xl" title={tag.name}>#{tag.name}</p>
                <span class="pill shrink-0">{tag.count} article{tag.count !== 1 ? "s" : ""}</span>
              </a>
            ))}
          </div>
        </>
      )
    }
  </Section>
</Layout>
